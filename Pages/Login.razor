@page "/"
@page "/login"
@using System.Text.RegularExpressions
@inject NavigationManager Nav

<h3>Вход в медицинский кабинет</h3> 
<p/>
<div class="login-form">
    <div>
        <label>@@ Электронная почта</label> 
        <input type="email" @bind="email" @oninput="@ValidateEmail" 
            style="@(isEmailInvalid ? "border-color:red; outline:none;" : "")"/>
    </div>

    <div>
        <label>🔒 Пароль</label> 
        <input type="password" @bind="password" @oninput="@ValidatePwd"
            style="@(isPasswordInvalid ? "border-color: red;" : "")"/>
     </div>

    <button disabled="@(isEmailInvalid || isPasswordInvalid || isLockedOut)" @onclick="AttemptLogin">Войти</button> 
    @if (isLockedOut)
    {
        <div style="color:red">Слишком много неудачных попыток. Попробуйте через минуту.</div> }

    <div>
        <a href="/register">Зарегистрироваться</a> | <a href="/forgot">Забыли пароль?</a> 
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    
    private int failedAttempts = 0; // Счетчик попыток [cite: 67]
    private bool isLockedOut = false;

    // Валидация email в реальном времени [cite: 60]
    private bool isEmailInvalid = true;
    
    // Валидация пароля (12 символов, 1 цифра, 1 спецсимвол) [cite: 63]
    private bool isPasswordInvalid = true;

    private void ValidateEmail(ChangeEventArgs e)
    {
        email = e.Value.ToString();
        isEmailInvalid = !string.IsNullOrEmpty(email) && 
            !Regex.IsMatch(email, @"[^@]+@[^@]+\.[^@]+");
    }

    private void ValidatePwd(ChangeEventArgs e)
    {
        password = e.Value.ToString();
        isPasswordInvalid = !string.IsNullOrEmpty(password) && 
            (password.Length < 12 || !Regex.IsMatch(password, @"\d") ||
            !Regex.IsMatch(password, @"[!@#$%^&*]"));
    }

    private void AttemptLogin()
    {
        Classes.Helper.IsAuthorized = true;
        Nav.NavigateTo("/home");
    }
}